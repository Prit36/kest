{
  "info": {
    "_postman_id": "8f1b4b1a-0000-4000-8000-000000000001",
    "name": "Pet Store",
    "description": { "content": "A sample of what Postman writes.", "type": "text/markdown" },
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["console.log(1)"] } }],
  "variable": [{ "key": "baseUrl", "value": "https://petstore.example.com" }],
  "item": [
    {
      "name": "Pets",
      "description": "Everything about pets",
      "item": [
        {
          "name": "List pets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Debug", "value": "1", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["pets"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" },
                { "key": "status", "value": "sold", "disabled": true }
              ]
            },
            "description": "Lists pets."
          },
          "response": [
            { "name": "OK", "status": "OK", "code": 200, "body": "[]" }
          ]
        },
        {
          "name": "Create pet",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('ok', () => {})"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rex\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/pets", "host": ["{{baseUrl}}"], "path": ["pets"] }
          }
        },
        {
          "name": "Get pet",
          "request": {
            "method": "GET",
            "url": {
              "protocol": "https",
              "host": ["petstore", "example", "com"],
              "port": "8443",
              "path": ["pets", ":id"],
              "variable": [{ "key": "id", "value": "1" }],
              "query": [{ "key": "full", "value": "true" }]
            }
          }
        }
      ]
    },
    {
      "name": "Upload photo",
      "request": {
        "auth": { "type": "basic", "basic": [] },
        "method": "POST",
        "url": "https://petstore.example.com/photos?album=a",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "title", "value": "Rex", "type": "text" },
            { "key": "photo", "type": "file", "src": ["C:\\pets\\rex.png", "C:\\pets\\rex2.png"] },
            { "key": "off", "value": "x", "type": "text", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "https://petstore.example.com/login",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "user", "value": "me" },
            { "key": "pass", "value": "{{password}}" }
          ]
        }
      }
    },
    {
      "name": "Binary",
      "request": { "method": "PUT", "url": "https://petstore.example.com/blob", "body": { "mode": "file", "file": { "src": "/tmp/blob.bin" } } }
    },
    {
      "name": "Graph",
      "request": {
        "method": "POST",
        "url": "https://petstore.example.com/graphql",
        "body": { "mode": "graphql", "graphql": { "query": "{ pets { id } }", "variables": "" } }
      }
    },
    { "name": "Bare URL", "request": "https://petstore.example.com/ping?x=1" }
  ]
}
